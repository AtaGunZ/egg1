   "text_tr": "metin",
   "page": 1,
   "category": "heights",
   "automation": "auto",
   "requires": [
    "building_model"
   ],
   "severity": "error",
   "applies_when": {
    "building_use": null,
    "min_storeys": null,
    "max_storeys": null,
    "storey_kind": null
   },
   "check": {
    "type": "min",
    "target": {
     "kind": "space",
     "usage_in": [
      "living_room",
      "bedroom"
     ],
     "usage_not_in": null,
     "where": null
    },
    "measure": "height",
    "op": ">=",
    "limit": 2.6,
    "unit": "m",
    "tolerance": 0.005,
    "exceptions": [
     "Hava maniasi olan parsellerde 2.40 m"
    ]
   }
  },
